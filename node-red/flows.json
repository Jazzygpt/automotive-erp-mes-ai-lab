        "z": "tab-automotive",
        "name": "function 2",
        "func": "\nconst wo = msg.payload?.data;\n\nif (msg.statusCode !== 200 || !wo) {\n    node.error(\"Invalid ERPNext response\", msg);\n    return null;\n}\n\nif (wo.company !== \"Zebline Systems Ltd\") {\n    node.error(\"Unexpected ERP company\", msg);\n    return null;\n}\n\nmsg.payload = {\n    erp_work_order_id: wo.name,\n    product_code: wo.production_item,\n    product_name: wo.item_name,\n    target_quantity: Number(wo.qty),\n    erp_produced_quantity: Number(wo.produced_qty),\n    erp_status: wo.status,\n    bom_number: wo.bom_no,\n    machine_id: \"ASSEMBLY-01\",\n    components: (wo.required_items || []).map(item => ({\n        item_code: item.item_code,\n        required_quantity: Number(item.required_qty),\n        transferred_quantity: Number(item.transferred_qty)\n    }))\n};\n\nreturn msg;\n",
