    {
        "id": "814b2ad075820aa7",
        "type": "function",
        "z": "tab-automotive",
        "name": "MES Production Order Tracking",
        "func": "\nconst p = msg.payload;\n\nlet mes = flow.get(\"mes\") || {\n    work_order: \"WO-1001\",\n    product: \"Automotive Bracket\",\n    target: 1000,\n    good: 0,\n    rejected: 0,\n    lastProduced: Number(p.produced),\n    lastRejected: Number(p.rejected)\n};\n\nconst produced = Number(p.produced);\nconst rejected = Number(p.rejected);\n\nconst delta = produced >= mes.lastProduced\n    ? produced - mes.lastProduced : 0;\n\nconst rejectDelta = rejected >= mes.lastRejected\n    ? rejected - mes.lastRejected : 0;\n\nconst scrap = Math.min(delta, rejectDelta);\n\nmes.good += delta - scrap;\nmes.rejected += scrap;\n\nmes.lastProduced = produced;\nmes.lastRejected = rejected;\n\nmes.remaining = Math.max(0, mes.target - mes.good);\nmes.machine_status = p.status;\nmes.updated_at = p.timestamp;\n\nflow.set(\"mes\", mes);\n\nmsg.payload = mes;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 300,
        "wires": [
