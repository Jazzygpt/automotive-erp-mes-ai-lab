    {
        "id": "15bd8fd89cfb3309",
        "type": "function",
        "z": "tab-automotive",
        "name": "Validate ERP Manufacturing Entry",
        "func": "const entry = msg.payload.message || msg.payload.data;\n\nif (!entry || entry.doctype !== \"Stock Entry\") {\n    node.error(\"Invalid Stock Entry response\", msg);\n    return null;\n}\n\nif (entry.stock_entry_type !== \"Manufacture\") {\n    node.error(\"Expected Manufacture Stock Entry\", msg);\n    return null;\n}\n\nif (entry.work_order !== \"MFG-WO-2026-00003\") {\n    node.error(\"Unexpected Work Order\", msg);\n    return null;\n}\n\nconst items = entry.items || [];\nconst expected = {\n    \"AAL-NUT-M8\": 20,\n    \"AAL-BLANK-001\": 10,\n    \"AAL-BOLT-M8\": 20,\n    \"AAL-BRACKET-001\": 10\n};\n\nif (items.length !== 4) {\n    node.error(\"Expected exactly four item rows\", msg);\n    return null;\n}\n\nfor (const [code, qty] of Object.entries(expected)) {\n    const matches = items.filter(i => i.item_code === code);\n    if (matches.length !== 1 ||\n        Number(matches[0].qty) !== qty) {\n        node.error(`Incorrect quantity for ${code}`, msg);\n        return null;\n    }\n}\n\nconst finished = items.find(\n    i => i.item_code === \"AAL-BRACKET-001\"\n);\n\nif (Number(finished.is_finished_item) !== 1 ||\n    finished.t_warehouse !== \"Finished Goods - ZSL\") {\n    node.error(\"Finished goods warehouse or flag incorrect\", msg);\n    return null;\n}\n\nif (Number(entry.docstatus) !== 0) {\n    node.error(\"Expected a draft Stock Entry\", msg);\n    return null;\n}\n\nnode.status({fill:\"green\",shape:\"dot\",text:\"Draft validated\"});\nreturn msg;\n",
