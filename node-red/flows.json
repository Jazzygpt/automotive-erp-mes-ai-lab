    {
        "id": "7ffc49e6bc3a85ae",
        "type": "function",
        "z": "tab-automotive",
        "name": "function 1",
        "func": "\nconst m = flow.get(\"mes\");\n\nif (!m) {\n    msg.statusCode = 503;\n    msg.payload = \"Waiting for MES production data\";\n    return msg;\n}\n\nconst good = Number(m.good) || 0;\nconst rejected = Number(m.rejected) || 0;\nconst target = Number(m.target) || 1000;\nconst progress = (good / target * 100).toFixed(1);\nconst quality = good + rejected > 0\n    ? (good / (good + rejected) * 100).toFixed(1)\n    : \"0.0\";\n\nmsg.headers = {\"Content-Type\": \"text/html\"};\n\nmsg.payload = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta http-equiv=\"refresh\" content=\"3\">\n<title>Automotive MES</title>\n<style>\nbody {\n  background:#0f172a;\n  color:white;\n  font-family:Arial,sans-serif;\n  padding:35px;\n}\nh1 { color:#38bdf8; }\n.grid { display:flex; flex-wrap:wrap; gap:15px; }\n.card {\n  background:#1e293b;\n  border-radius:12px;\n  padding:25px;\n  min-width:160px;\n}\n.value {font-size:35px;font-weight:bold;}\n.bar {background:#334155;border-radius:8px;overflow:hidden;}\n.fill {\n  background:#22c55e;\n  height:22px;\n  width:${Math.min(100,Number(progress))}%;\n}\n</style>\n</head>\n<body>\n<h1>Automotive Manufacturing MES</h1>\n<h2>Work Order: WO-1001</h2>\n<p>Product: Automotive Bracket</p>\n<p>Machine: ASSEMBLY-01</p>\n<div class=\"grid\">\n<div class=\"card\">Target<div class=\"value\">${target}</div></div>\n<div class=\"card\">Good Parts<div class=\"value\">${good}</div></div>\n<div class=\"card\">Rejected<div class=\"value\">${rejected}</div></div>\n<div class=\"card\">Remaining<div class=\"value\">${Math.max(0,target-good)}</div></div>\n<div class=\"card\">Quality Yield<div class=\"value\">${quality}%</div></div>\n<div class=\"card\">Machine<div class=\"value\">${m.machine_status || \"UNKNOWN\"}</div></div>\n</div>\n<h2>Production Progress: ${progress}%</h2>\n<div class=\"bar\"><div class=\"fill\"></div></div>\n<p>Live production data. Refreshes every 3 seconds.</p>\n</body>\n</html>`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
