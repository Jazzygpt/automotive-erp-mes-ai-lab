    {
        "id": "page-template",
        "type": "template",
        "z": "tab-automotive",
        "name": "Display dashboard HTML",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "plain",
        "template": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Assembly-01 | Virtual Automotive Factory</title>\n<style>\n:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#e9f0fa;background:#0b1120}\nbody{max-width:1120px;margin:0 auto;padding:28px 18px}h1{font-size:clamp(1.5rem,3vw,2.4rem);margin:0 0 8px}\n.subtitle{color:#aab9cf;margin:0 0 26px}.top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center}\n.pill{border:1px solid #617085;background:#263549;padding:8px 15px;border-radius:40px;font-weight:bold}\n.ok{background:#124734;color:#bbf7d0;border-color:#247857}.fault{background:#621d2a;color:#fecaca;border-color:#b63753}.stop{background:#5b401a;color:#fde68a;border-color:#b5791e}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:24px}\n.card{background:#182338;border:1px solid #2a3a55;border-radius:14px;padding:20px}\n.name{font-size:0.86rem;color:#aab9cf}.value{font-size:2.0rem;font-weight:750;margin:8px 0 2px;font-variant-numeric:tabular-nums}\n.unit{font-size:.95rem;color:#aab9cf;font-weight:450}.foot{margin-top:25px;color:#aab9cf;font-size:0.9rem;line-height:1.65}\ncode{background:#253149;padding:3px 6px;border-radius:5px}\n</style></head><body>\n<div class=\"top\"><div><h1>Automotive assembly cell</h1><p class=\"subtitle\">Factory lab / Machine ASSEMBLY-01 / Simulated telemetry</p></div><span id=\"status\" class=\"pill\">CONNECTING</span></div>\n<div class=\"grid\">\n<div class=\"card\"><div class=\"name\">Parts produced (total)</div><div id=\"produced\" class=\"value\">—</div></div>\n<div class=\"card\"><div class=\"name\">Good parts</div><div id=\"good_parts\" class=\"value\">—</div></div>\n<div class=\"card\"><div class=\"name\">Rejected parts</div><div id=\"rejected\" class=\"value\">—</div></div>\n<div class=\"card\"><div class=\"name\">Temperature</div><div class=\"value\"><span id=\"temperature_c\">—</span> <span class=\"unit\">°C</span></div></div>\n<div class=\"card\"><div class=\"name\">Cycle time (simulated)</div><div class=\"value\"><span id=\"cycle_time_s\">—</span> <span class=\"unit\">s</span></div></div>\n<div class=\"card\"><div class=\"name\">Vibration</div><div class=\"value\"><span id=\"vibration_mm_s\">—</span> <span class=\"unit\">mm/s</span></div></div>\n</div>\n<p class=\"foot\">Signal path: virtual sensors → virtual PLC (Modbus TCP) → Python gateway → MQTT broker → Node-RED → this dashboard.<br>\nLast sample: <span id=\"sample\">waiting for telemetry</span>. Refreshes every 2 seconds.<br>\nThis is a synthetic demo, not a safety-rated PLC, production MES or physical sensor installation. Open <code>http://localhost:1880</code> to inspect the Node-RED flows.</p>\n<script>\nasync function poll(){\n try{\n  const response=await fetch('/factory/api/latest',{cache:'no-store'});\n  if(!response.ok)throw new Error('No current data');\n  const data=await response.json();\n  for(const key of ['produced','good_parts','rejected','temperature_c','cycle_time_s','vibration_mm_s']){\n    document.getElementById(key).textContent=String(data[key] ?? '—');\n  }\n  const el=document.getElementById('status');\n  el.textContent=data.status || 'UNKNOWN';\n  el.className='pill '+(data.status==='RUNNING'?'ok':data.status==='FAULT'?'fault':'stop');\n  const ts=Date.parse(data.timestamp), age=Date.now()-ts;\n  document.getElementById('sample').textContent=isNaN(ts)?data.timestamp:new Date(ts).toLocaleString() + (age > 10000?' (stale)':'');\n }catch(error){document.getElementById('status').textContent='NO DATA';document.getElementById('status').className='pill fault';}\n}\npoll();setInterval(poll,2000);\n</script></body></html>",
        "output": "str",
